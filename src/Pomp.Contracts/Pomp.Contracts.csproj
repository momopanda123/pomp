<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Shared contracts of pomp: omp RPC wire model, bridge/tool/permission interfaces,
    Visual Studio adapter interfaces and the WebView UI protocol.
    No Visual Studio dependency, so it is loadable by both VSIX flavours (VS 2019 x86, VS 2022+ x64)
    and by standalone test harnesses.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Pomp</RootNamespace>
    <AssemblyName>Pomp.Contracts</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      13.0.3 has assembly version 13.0.0.0: VS 2022 (0.0.0.0-13.0.0.0) and VS 2026 (4.5.0.0-13.0.4.0)
      redirect it to their own copy; the VS 2019 VSIX ships this copy as a fallback.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
