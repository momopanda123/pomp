{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POMP project tool policy",
  "description": "Optional, default-deny cooperative tool filter that only narrows the normal approvals (without this file the normal approvals apply). Does not provide OS isolation. Use this schema through an editor schema association; runtime policy keys are exactly those defined below.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "default",
    "rules"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "default": {
      "const": "deny"
    },
    "requireSandbox": {
      "type": "boolean"
    },
    "requireReviewedEdits": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "effect"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "pattern": "^(?:\\*|[a-zA-Z0-9_.:-]{1,100})$"
          },
          "effect": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!(?:.*[/\\\\])?\\.\\.(?:[/\\\\]|$))[^\\u0000]+$",
              "description": "Workspace-relative file or directory prefix. Absolute paths and any .. path component are rejected by the runtime; this is not a shell/filesystem sandbox."
            }
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]+$"
            }
          }
        }
      }
    }
  }
}
