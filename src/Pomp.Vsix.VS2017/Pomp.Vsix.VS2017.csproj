<Project>
  <!--
    VSIX for Visual Studio 2017 (15.9): 32-bit devenv.exe.

    All Visual Studio specific source lives in ..\Pomp.VisualStudio and is shared with the other VSIX flavours; everything
    that is identical between them is in ..\Pomp.VisualStudio\Pomp.Vsix.Common.targets. This flavour compiles against the
    15.9 SDK (Microsoft.VisualStudio.Threading 15.8: the shared sources branch on VS2017 where a 16.x overload is used).
    No native CodeLens captions: the 15.8 CodeLens API has no custom details presenter (CodeLensDetailsDescriptor.CustomData),
    so this flavour ships without the CodeLens provider and hides that option (POMP's own code captions still work).

    SDK-style project with explicit SDK imports: Microsoft.VSSDK.BuildTools' Microsoft.VsSDK.targets (pkgdef,
    VSCT, VSIX container) must be imported AFTER Microsoft.NET.Sdk's targets.
    Build with MSBuild from Visual Studio (not "dotnet build"):
      MSBuild.exe Pomp.Vsix.VS2017.csproj -restore -p:Configuration=Release
  -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Pomp.VisualStudio</AssemblyName>
    <RootNamespace>Pomp.VisualStudio</RootNamespace>
    <DefineConstants>$(DefineConstants);VS2017</DefineConstants>

    <PompVsFlavor>VS2017</PompVsFlavor>
    <!-- Architecture of the devenv.exe process that hosts this flavour (selects WebView2Loader.dll). -->
    <PompLoaderArch>x86</PompLoaderArch>
    <!-- VS 2017 ships an older Newtonsoft.Json, so this VSIX carries its own 13.0.x copy. -->
    <PompShipNewtonsoftJson>true</PompShipNewtonsoftJson>
    <TargetVsixContainerName>Pomp.VS2017.vsix</TargetVsixContainerName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: the Visual Studio SDK assemblies are provided by the IDE and must not be packaged. -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="15.9.3" ExcludeAssets="runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Microsoft.VisualStudio.SDK 15.9.3 depends on CoreUtility 16.0.112, but VS 2017 only redirects CoreUtility up to 15.0.0.0:
         compiled against 16.0, every PropertyCollection or [ContentType]/[Name] use fails to load in VS 2017. Pin the 15.x API. -->
    <PackageReference Include="Microsoft.VisualStudio.CoreUtility" Version="15.8.525" ExcludeAssets="runtime" NoWarn="NU1605">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- NuGet interfaces are supplied by Visual Studio; never ship a second runtime copy. -->
    <PackageReference Include="Microsoft.VisualStudio.Validation" Version="15.5.31" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Roslyn of VS 2017 15.9 (the shadow validator compiles against this workspace API). -->
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="2.10.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="NuGet.VisualStudio" Version="4.9.6" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- The build tooling (pkgdef, VSCT, VSIX container) is independent of the targeted IDE. -->
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="16.11.71" />
    <!-- VS 2017 has no WebView2 of its own: this copy (and its x86 loader) is what runs.
         1.0.1901.177 is the first whose CoreWebView2WebMessageReceivedEventArgs.AdditionalObjects returns CoreWebView2File objects
         (files dropped on the page); 1.0.1774.30 to 1.0.1823.32 throw a RuntimeBinderException there. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1901.177" />
    <!-- Same version Pomp.Contracts uses; packaged explicitly (see PompShipNewtonsoftJson in the common targets). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pomp.Contracts\Pomp.Contracts.csproj" />
    <ProjectReference Include="..\Pomp.CodeLens.Contracts\Pomp.CodeLens.Contracts.csproj" />
    <ProjectReference Include="..\Pomp.Core\Pomp.Core.csproj" />
    <ProjectReference Include="..\Pomp.Tools\Pomp.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Already part of the default None glob; Update only adds the designer hint. -->
    <None Update="source.extension.vsixmanifest" SubType="Designer" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="..\Pomp.VisualStudio\Pomp.Vsix.Common.targets" />
  <!-- Roslyn's VS workspace contract references this interop assembly; use the IDE copy consistently. -->
  <Target Name="PompAlignRoslynInterop" BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePathWithRefAssemblies Update="@(ReferencePathWithRefAssemblies)" Condition="'%(ReferencePathWithRefAssemblies.Filename)' == 'Microsoft.VisualStudio.Shell.Interop.11.0'">
        <EmbedInteropTypes>false</EmbedInteropTypes>
      </ReferencePathWithRefAssemblies>
    </ItemGroup>
  </Target>
</Project>
