<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="Pomp.VSIX.VS2019" Version="0.5.5" Language="en-US" Publisher="momopanda123" />
    <DisplayName>POMP (VS2019)</DisplayName>
    <Description xml:space="preserve">AI coding partner inside Visual Studio 2019. Chat with an agent that works with the editor buffers, the solution, the Error List, builds, tests, the debugger, NuGet and Git, and asks before it changes or runs anything. / Visual Studio 안의 AI 코딩 파트너. 에이전트가 편집기·솔루션·오류 목록·빌드·테스트·디버거·NuGet·Git을 사용하고, 바꾸거나 실행하기 전에는 먼저 묻습니다.</Description>
    <License>LICENSE.txt</License>
    <Icon>Resources\PompIcon.png</Icon>
    <PreviewImage>Resources\PompPreview.png</PreviewImage>
    <Tags>AI, agent, chat, assistant, coding</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[16.10,17.0)" />
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[16.10,17.0)" />
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[16.10,17.0)" />
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.7.2,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[16.0,17.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%|" />
    <Asset Type="Microsoft.VisualStudio.CodeLensComponent" d:Source="Project" d:ProjectName="Pomp.CodeLens.Provider" Path="|Pomp.CodeLens.Provider|" />
  </Assets>
</PackageManifest>
