 /// Requests activation without attaching to an untrusted input queue or
 /// injecting a dummy key into whichever application currently has focus.
-/// Foreground-lock refusal is handled by the caller before it sends input.
+///
+/// Windows hands the foreground over from another application only to the
+/// process that provided the last input. A host that has sent no input itself
+/// yet (its user last typed into another application, such as the IDE that
+/// launched it) is refused even for takeover. A zero-distance relative mouse
+/// move first makes this process that input provider: it moves no pointer and
+/// reaches no keyboard handler. A remaining refusal is handled by the caller
+/// before it sends input.
 pub(super) fn activate(target: HWND) -> CoreResult<bool> {
 	control::check()?;
-	// SAFETY: both functions take only OS-validated handles and scalar state.
+	let nudge = INPUT {
+		r#type:    INPUT_MOUSE,
+		Anonymous: INPUT_0 {
+			mi: MOUSEINPUT {
+				dx:          0,
+				dy:          0,
+				mouseData:   0,
+				dwFlags:     MOUSEEVENTF_MOVE,
+				time:        0,
+				dwExtraInfo: 0,
+			},
+		},
+	};
+	// SAFETY: these functions take only OS-validated handles and scalar state;
+	// `nudge` is one initialized INPUT copied synchronously by Win32.
 	unsafe {
+		if GetForegroundWindow() != target {
+			// A refused nudge (secure desktop, higher-integrity foreground) leaves
+			// the plain request below, whose refusal the caller reports.
+			SendInput(1, &nudge, size_of::<INPUT>() as i32);
+		}
 		SetForegroundWindow(target);
 		Ok(GetForegroundWindow() == target)
 	}
