<Project>
  <!--
    Every POMP VSIX ships this locally patched omp build. The version, size and hash are verified at build time and at startup;
    the official upstream executable cannot be substituted. The upstream tag/commit and patch are pinned in build/build-omp.ps1.
    To update omp, rebuild from the new pinned source and patch, verify behavior, then update the size, hash and provenance together.
    PompOmpNoticesSha256 pins the notices build/build-omp.ps1 composes from the tag (the text of omp's license option).
  -->
  <PropertyGroup>
    <PompOmpVersion>18.21.0</PompOmpVersion>
    <PompOmpAsset>omp.exe</PompOmpAsset>
    <PompOmpSource>oh-my-pi@6f03614d761366972e80e84e25d1418ed678d2c7 + engines/omp/pomp-v18.21.0.patch + engines/omp/gpt-6.2-v18.21.0.patch (upstream 2dedb850ac86e73aadc385e5b9cf08eac096e475) + src/Pomp.McpServer</PompOmpSource>
    <PompOmpSha256>3a748b1bb3fbcb679109a9930bfa53ad222ba363bd1ab756cecdec64faca1b34</PompOmpSha256>
    <PompOmpSize>254009856</PompOmpSize>
    <PompOmpNoticesSha256>d763dc4998ee0950ff91812c828b4c57082b395c16510e757df720d49100dbdf</PompOmpNoticesSha256>
  </PropertyGroup>
</Project>
